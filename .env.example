# 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋하지 않는다(.gitignore).
#   cp .env.example .env

# 프록시 자체 인증 키. 직원 SDK가 api_key 자리에 넣는 값이며,
# 업스트림 벤더 키와 절대 같은 값을 쓰지 않는다. 생성: openssl rand -hex 32
PROXY_API_KEY=

# 업스트림 벤더 키. L7에서 교체 주입된다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# L7 currently uses CLAUDE_API_KEY for Anthropic.
CLAUDE_API_KEY=
# Optional Anthropic-compatible API base URL (not the full messages URL).
# MonoGPT example: https://monogpt.kr/api/monorouter/v1/anthropic
# Empty uses the official Anthropic API.
CLAUDE_API_BASE_URL=
# anthropic (default): x-api-key + /v1/messages
# openai: Bearer + /chat/completions, e.g. MonoGPT Universal API
# For Universal use https://monogpt.kr/api/monorouter/v1
CLAUDE_API_FORMAT=anthropic

DEMO_MODE=false

# L6 Vault
REDIS_URL=redis://localhost:6379/0
# AES-256 키. 32바이트를 base64로. 생성: openssl rand -base64 32
VAULT_ENCRYPTION_KEY=
# 토큰↔원문 매핑 보존 시간(초). 세션이 끝나면 만료시켜 노출 창을 줄인다.
VAULT_TTL_SECONDS=3600

# 운영
LOG_LEVEL=INFO
