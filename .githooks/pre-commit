#!/bin/sh
#
# core.hooksPath를 쓰면 `pre-commit install`이 거부되므로
# (Cowardly refusing to install hooks with `core.hooksPath` set)
# 여기서 pre-commit 프레임워크를 직접 호출한다.
#
# 훅 목록은 .pre-commit-config.yaml 참고 (ruff, gitleaks, mypy 등).
# 우회: git commit --no-verify

[ -f .pre-commit-config.yaml ] || exit 0
[ -f pyproject.toml ] || exit 0
command -v uv >/dev/null 2>&1 || {
	printf 'pre-commit: uv가 없어 검사를 건너뜁니다.\n' >&2
	exit 0
}

exec uv run pre-commit run --hook-stage pre-commit
